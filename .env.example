# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Local: http://localhost:1224
# Production: https://your-project.vercel.app or your custom domain
NEXT_PUBLIC_SITE_URL=http://localhost:1224

# Admin accounts live in the `admins` table (email + hashed password), seeded
# with `node scripts/create-admin.mjs <email> <password>`. This secret signs
# the admin login session cookie; use a long random value.
ADMIN_SESSION_SECRET=replace-with-a-long-random-value

# -----------------------------------------------------------------------------
# Supabase
# Get these values from Supabase Dashboard -> Connect / Settings -> API Keys.
# Publishable values are safe for browser use when Row Level Security is enabled.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Never prefix these with NEXT_PUBLIC_ and never commit real values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Database connection strings. Prefer the transaction pooler for Vercel runtime
# traffic and the non-pooling/direct URL for migrations and schema tooling.
POSTGRES_URL=postgresql://postgres.your-project-ref:password@pooler-host:6543/postgres?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Weekly video links are managed from /admin (stored in the `week_videos`
# table), not environment variables — paste a link there and it's live
# immediately, no redeploy needed.

# Local design/testing only. Leave empty in production so the real dates
# control which week is open. Set 1-4 to preview that week locally.
CAMPAIGN_PREVIEW_WEEK=

# Local functional testing only. When true under `next dev`, all four weeks
# can be checked in consecutively. It is ignored in production builds.
CAMPAIGN_TEST_MODE=false

# -----------------------------------------------------------------------------
# Email reminders (Brevo)
# -----------------------------------------------------------------------------
BREVO_API_KEY=xkeysib-...
REMINDER_FROM=起初的光 <reminder@example.com>

# Vercel Cron automatically sends this value as Authorization: Bearer <value>.
# Use a random value of at least 16 characters.
CRON_SECRET=replace-with-a-long-random-value

# Legacy local/Cloudflare name; optional while migrating. It may equal
# CRON_SECRET and can be removed after the Vercel migration is complete.
REMINDER_CRON_SECRET=replace-with-the-same-long-random-value
